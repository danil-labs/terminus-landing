---
import "../styles/global.css";
import Maqueta from "../components/Maqueta.astro";
import MarcaAgente from "../components/MarcaAgente.astro";

/**
 * La página de Terminus.
 *
 * **Una idea, tres pasos y la descarga.** Todo lo que dice tiene que poder
 * comprobarse en la app de hoy. Lo que es visión —gobernanza, roles, políticas
 * de una organización— no entra hasta que `harness-app` lo construya: una
 * promesa que la primera instalación desmiente cuesta más que no hacerla.
 *
 * Los textos de «Cómo funciona» salen de la propia app: la preparación
 * (`src/locales/es/setup.json`) y el alta (`onboarding.json`) de `harness-app`.
 * Si allá cambia la forma de empezar, esto queda viejo.
 */
const RELEASES = "https://github.com/danil-labs/terminus/releases/latest";
/**
 * **Nombres estables, sin versión dentro.** `latest` resuelve la release, pero
 * el nombre del archivo tiene que existir tal cual en ella: cada release publica
 * una copia con estos nombres para que los botones no caduquen. El `.dmg` es
 * universal, Apple Silicon e Intel.
 */
const DESCARGA_WINDOWS = `${RELEASES}/download/Terminus-Windows-Setup.exe`;
const DESCARGA_MAC = `${RELEASES}/download/Terminus-macOS.dmg`;
const VERSIONES = "https://github.com/danil-labs/terminus/releases";
const ICONO = "/marca/terminus-icono.png";
/**
 * Los que ofrece el alta de la app (`runtime/agents/table.rs`), con su marca.
 * «Gemini» es la fila de Antigravity, que el alta rotula «Gemini / Antigravity».
 */
const AGENTES = [
  { id: "claude", nombre: "Claude Code" },
  { id: "codex", nombre: "Codex" },
  { id: "gemini", nombre: "Gemini" },
  { id: "grok", nombre: "Grok" },
  { id: "opencode", nombre: "OpenCode" },
  { id: "local", nombre: "Modelos locales" },
] as const;
/**
 * La versión publicada, preguntada a GitHub **al compilar**, no escrita a mano:
 * un número escrito se queda viejo con la siguiente release. Sale HTML estático,
 * sin petición por visitante. Si GitHub no contesta, la página sale sin número:
 * un dato que falta se nota menos que uno falso.
 */
async function versionPublicada(): Promise<string | null> {
  try {
    const r = await fetch(
      "https://api.github.com/repos/danil-labs/terminus/releases/latest",
      {
        headers: {
          Accept: "application/vnd.github+json",
          "User-Agent": "terminus-landing",
          // En CI el token viene del propio flujo: sin él, las IP de Actions
          // comparten el tope de 60 peticiones por hora.
          ...(process.env.GITHUB_TOKEN
            ? { Authorization: `Bearer ${process.env.GITHUB_TOKEN}` }
            : {}),
        },
      },
    );
    if (!r.ok) return null;
    const d = await r.json();
    return typeof d.tag_name === "string" ? d.tag_name.replace(/^v/, "") : null;
  } catch {
    return null;
  }
}
const VERSION = await versionPublicada();

const GLIFO_WINDOWS =
  "M3 5.6 10.4 4.5v7.1H3zM11.6 4.3 21 3v8.6h-9.4zM3 12.5h7.4v7.1L3 18.5zM11.6 12.5H21V21l-9.4-1.3z";
const GLIFO_MAC =
  "M16.4 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.6.8-3.3.8s-1.7-.8-2.9-.8c-1.5 0-2.9.9-3.6 2.2-1.6 2.7-.4 6.7 1.1 8.9.7 1.1 1.6 2.3 2.7 2.2 1.1 0 1.5-.7 2.8-.7s1.6.7 2.8.7 1.9-1.1 2.6-2.1c.8-1.2 1.2-2.4 1.2-2.4s-2.2-.9-2.4-3.6zM14.3 6.1c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terminus — tus agentes de IA, en una sola app</title>
    <meta
      name="description"
      content="Terminus es una app de escritorio para trabajar con agentes de IA —Claude Code, Codex, Gemini, Grok, OpenCode o modelos locales— sobre tus carpetas y repositorios, con tus propias cuentas."
    />
    <meta property="og:title" content="Terminus" />
    <meta property="og:description" content="Tus agentes de IA, en una sola app." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0d23" />
    <link rel="canonical" href="https://terminus.danil.ai/" />
    <link rel="icon" href={ICONO} type="image/png" />
    <link rel="apple-touch-icon" href={ICONO} />
    <link rel="preload" href="/fuentes/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body>
    <!-- Sin botón de descarga arriba: la descarga está en el primer pantallazo,
         justo debajo. Un segundo botón que lleva al mismo sitio solo compite. -->
    <header class="nav">
      <div class="envoltura nav__fila">
        <a class="marca" href="/">
          <span class="marca__placa">
            <img src={ICONO} alt="" width="17" height="17" />
          </span>
          Terminus
        </a>
      </div>
    </header>

    <main>
      <section class="envoltura hero">
        <h1>Tus agentes de IA, en una sola app.</h1>
        <p class="bajada">
          Terminus es una app de escritorio para trabajar con agentes de IA sobre
          tus carpetas y repositorios, con tus propias cuentas.
        </p>

        <div class="descargas">
          <a class="boton boton--accion" href={DESCARGA_WINDOWS}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GLIFO_WINDOWS} /></svg>
            Descargar para Windows
          </a>
          <a class="boton boton--linea" href={DESCARGA_MAC}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GLIFO_MAC} /></svg>
            Descargar para macOS
          </a>
        </div>
        <p class="datos">
          {
            VERSION && (
              <>
                <a class="mono" href={RELEASES}>v{VERSION}</a>
                <span class="punto" aria-hidden="true">·</span>
              </>
            )
          }
          Windows 10 u 11 y macOS
        </p>

        <div class="agentes">
          <p class="agentes__rotulo">Funciona con</p>
          <ul class="agentes__lista">
            {
              AGENTES.map((a) => (
                <li class="agente">
                  <MarcaAgente id={a.id} size={15} />
                  {a.nombre}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <div class="envoltura">
        <Maqueta />
      </div>

      <section class="envoltura como">
        <h2>Cómo funciona</h2>
        <ol class="pasos">
          <li class="paso">
            <span class="paso__num mono">01</span>
            <h3>Instalas y se prepara sola</h3>
            <p>
              Revisa lo que ya tienes en tu computadora e instala lo que falta.
              No necesitas escribir comandos.
            </p>
          </li>
          <li class="paso">
            <span class="paso__num mono">02</span>
            <h3>Conectas tus cuentas de IA</h3>
            <p>
              Usas tu propia suscripción. Lo que trabajas va de tu computadora a
              tu proveedor y no pasa por nosotros. Los modelos locales no
              necesitan cuenta.
            </p>
          </li>
          <li class="paso">
            <span class="paso__num mono">03</span>
            <h3>Le das una tarea sobre tu carpeta</h3>
            <!-- «Tú decides cuándo se guarda» es el botón Guardar de las
                 carpetas. En un repositorio el agente también puede hacer
                 commits si se lo pides: por eso no dice «nada cambia sin tu
                 permiso». -->
            <p>
              Una carpeta de documentos o un repositorio. Cada tarea trabaja en
              su propia copia, y tú decides cuándo se guarda en tu carpeta.
            </p>
          </li>
        </ol>
      </section>

      <section class="envoltura cierre">
        <h2>Pruébalo con una tarea de verdad.</h2>
        <div class="descargas">
          <a class="boton boton--accion" href={DESCARGA_WINDOWS}>Descargar para Windows</a>
          <a class="boton boton--linea" href={DESCARGA_MAC}>Descargar para macOS</a>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="envoltura">
        <div class="pie__fila">
          <span class="pie__marca">
            Terminus es de
            <a href="https://danil.ai">
              <img src="/marca/danil-wordmark.png" alt="Danil" width="46" height="15" />
            </a>
          </span>
          <span class="pie__enlaces">
            <a href={VERSIONES}>Versiones</a>
            <span aria-hidden="true">·</span>
            <a href="mailto:hola@danil.ai">hola@danil.ai</a>
          </span>
        </div>
        <p class="yucatan">Desde Yucatán con Amor <span aria-hidden="true">♥</span></p>
      </div>
    </footer>
  </body>
</html>
