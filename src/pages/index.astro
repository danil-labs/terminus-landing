    <script is:inline>
      /*
       * Dos cosas en un solo oyente de scroll: el paralaje del fondo y la barra
       * de arriba, que se enciende al despegarse. Van juntas porque dos oyentes
       * pintando a la vez es la forma más fácil de que una página vaya a
       * tirones — se lee `scrollY` una vez por cuadro y se escribe después.
       *
       * Y el paralaje se apaga entero con `prefers-reduced-motion`: un fondo
       * que se mueve solo es justo lo que marea a quien pide que no se mueva.
       */
      (() => {
        const quieto = matchMedia("(prefers-reduced-motion: reduce)");
        const capas = Array.from(document.querySelectorAll("[data-parallax]"));
        const barra = document.querySelector(".nav");
        /* Las capas sobresalen un 35 % del alto de la ventana por arriba y por
           abajo; pasado ese tope se vería el canto, así que ahí se detienen. */
        const TOPE = () => window.innerHeight * 0.3;
        let pendiente = false;

        const pintar = () => {
          pendiente = false;
          const y = window.scrollY;
          barra.classList.toggle("pegado", y > 8);
          if (quieto.matches) return;
          const tope = TOPE();
          for (const capa of capas) {
            const d = Math.min(y * Number(capa.dataset.parallax), tope);
            capa.style.transform = "translate3d(0," + -d.toFixed(1) + "px,0)";
          }
        };

        addEventListener(
          "scroll",
          () => {
            if (!pendiente) {
              pendiente = true;
              requestAnimationFrame(pintar);
            }
          },
          { passive: true },
        );
        pintar();
      })();
    </script>

    <script is:inline>
      /* El bloque `npx` es copiable: un clic pone el comando en el
         portapapeles y el botón lo confirma un momento. Si el navegador no da
         acceso al portapapeles, el comando sigue ahí para seleccionarlo a
         mano. */
      (() => {
        const btn = document.querySelector(".comando__copiar");
        if (!btn) return;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copiar);
            const antes = btn.textContent;
            btn.textContent = "Copiado";
            setTimeout(() => {
              btn.textContent = antes;
            }, 1500);
          } catch {}
        });
      })();
    </script>
